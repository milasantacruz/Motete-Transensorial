files:
  "/opt/certs/AmazonRootCA1.pem":
    mode: "000400"
    owner: webapp
    group: webapp
    source: https://s3.amazonaws.com/rds-downloads/rds-combined-ca-bundle.pem
    
  "/opt/certs/director-certificate.pem.crt":
    mode: "000400"
    owner: webapp
    group: webapp
    content: |
      -----BEGIN CERTIFICATE-----
      PLACEHOLDER_CERT_CONTENT
      -----END CERTIFICATE-----
      
  "/opt/certs/director-private.pem.key":
    mode: "000400"
    owner: webapp
    group: webapp
    content: |
      -----BEGIN RSA PRIVATE KEY-----
      PLACEHOLDER_KEY_CONTENT
      -----END RSA PRIVATE KEY-----

option_settings:
  aws:elasticbeanstalk:application:environment:
    AWS_IOT_ENDPOINT: a38a842oqvrvuj-ats.iot.us-east-2.amazonaws.com
    AWS_IOT_CLIENT_ID: director_aws
    AWS_CA_CERT_PATH: ../../../opt/certs/AmazonRootCA1.pem
    AWS_CLIENT_CERT_PATH: ../../../opt/certs/director-certificate.pem.crt
    AWS_PRIVATE_KEY_PATH: ../../../opt/certs/director-private.pem.key


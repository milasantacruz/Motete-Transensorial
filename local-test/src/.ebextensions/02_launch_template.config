# Configuración para usar Launch Templates en lugar de Launch Configurations
# AWS deprecó las Launch Configurations a partir del 1 de octubre de 2024
# Esta configuración fuerza el uso de Launch Templates estableciendo RootVolumeType como gp3

option_settings:
  aws:autoscaling:launchconfiguration:
    # Establecer el tipo de volumen raíz como gp3 fuerza el uso de Launch Templates
    # gp3 es más moderno, más rápido y más barato que gp2
    RootVolumeType: gp3
    # Deshabilitar IMDSv1 (también fuerza Launch Templates y mejora la seguridad)
    DisableIMDSv1: true

